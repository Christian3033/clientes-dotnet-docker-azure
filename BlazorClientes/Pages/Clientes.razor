@page "/clientes"
@using BlazorClientes.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http

<PageTitle>Clientes</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Administración de Clientes</h3>

        <button class="btn btn-primary" @onclick="NuevoCliente">
            Nuevo Cliente
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-@tipoMensaje alert-dismissible fade show">
            @mensaje

            <button
                type="button"
                class="btn-close"
                @onclick="CerrarMensaje">
            </button>
        </div>
    }

    @if (cargando)
    {
        <div class="alert alert-info">
            Cargando clientes...
        </div>
    }
    else if (clientes.Count == 0)
    {
        <div class="alert alert-secondary">
            No hay clientes registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>CUI</th>
                        <th>NIT</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Fecha de nacimiento</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var cliente in clientes)
                    {
                        <tr>
                            <td>@cliente.id_cliente</td>
                            <td>@cliente.cui</td>
                            <td>@cliente.nit</td>
                            <td>@cliente.nombres</td>
                            <td>@cliente.apellidos</td>
                            <td>@cliente.direccion</td>
                            <td>@cliente.telefono</td>
                            <td>@cliente.fecha_nacimiento.ToString("dd/MM/yyyy")</td>

                            <td class="text-nowrap">
                                <button
                                    class="btn btn-sm btn-success me-1"
                                    @onclick="() => EditarCliente(cliente)">
                                    Editar
                                </button>

                                <button
                                    class="btn btn-sm btn-danger"
                                    @onclick="() => ConfirmarEliminar(cliente)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <EditForm EditContext="@editContext" OnValidSubmit="@GuardarCliente">
                    <DataAnnotationsValidator />

                    <div class="modal-header">

                        <h5 class="modal-title">
                            @tituloModal
                        </h5>

                        <button
                            type="button"
                            class="btn-close"
                            @onclick="CerrarModal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">
                                    CUI
                                </label>

                                <InputText
                                    class="form-control"
                                    @bind-Value="clienteFormulario.cui" />

                                <ValidationMessage
                                    For="@(() => clienteFormulario.cui)"
                                    class="invalid-feedback d-block" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    NIT
                                </label>

                                <InputText
                                    class="form-control"
                                    @bind-Value="clienteFormulario.nit" />

                                <ValidationMessage
                                    For="@(() => clienteFormulario.nit)"
                                    class="invalid-feedback d-block" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Nombres
                                </label>

                                <InputText
                                    class="form-control"
                                    @bind-Value="clienteFormulario.nombres" />

                                <ValidationMessage
                                    For="@(() => clienteFormulario.nombres)"
                                    class="invalid-feedback d-block" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Apellidos
                                </label>

                                <InputText
                                    class="form-control"
                                    @bind-Value="clienteFormulario.apellidos" />

                                <ValidationMessage
                                    For="@(() => clienteFormulario.apellidos)"
                                    class="invalid-feedback d-block" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Dirección
                                </label>

                                <InputText
                                    class="form-control"
                                    @bind-Value="clienteFormulario.direccion" />

                                <ValidationMessage
                                    For="@(() => clienteFormulario.direccion)"
                                    class="invalid-feedback d-block" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Teléfono
                                </label>

                                <InputText
                                    class="form-control"
                                    @bind-Value="clienteFormulario.telefono" />

                                <ValidationMessage
                                    For="@(() => clienteFormulario.telefono)"
                                    class="invalid-feedback d-block" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Fecha de nacimiento
                                </label>

                                <InputDate
                                    class="form-control"
                                    @bind-Value="clienteFormulario.fecha_nacimiento" />
                            </div>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button
                            type="button"
                            class="btn btn-secondary"
                            @onclick="CerrarModal">
                            Cancelar
                        </button>

                        <button
                            type="submit"
                            class="btn btn-primary">
                            Guardar
                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>

    <div class="modal-backdrop fade show"></div>
}

@if (mostrarEliminar)
{
    <div class="modal fade show d-block" tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Eliminar Cliente
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        @onclick="CerrarEliminar">
                    </button>

                </div>

                <div class="modal-body">

                    <p class="mb-0">
                        ¿Está seguro de eliminar al cliente
                        <strong>
                            @clienteEliminar?.nombres
                            @clienteEliminar?.apellidos
                        </strong>?
                    </p>

                </div>

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        @onclick="CerrarEliminar">
                        Cancelar
                    </button>

                    <button
                        type="button"
                        class="btn btn-danger"
                        @onclick="EliminarCliente">
                        Eliminar
                    </button>

                </div>

            </div>

        </div>

    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {

    private List<Cliente> clientes = new();

    private Cliente clienteFormulario = new();
    private Cliente? clienteEliminar;

    private EditContext? editContext;

    private bool cargando = true;
    private bool mostrarModal;
    private bool mostrarEliminar;
    private bool editando;

    private string tituloModal = "Nuevo Cliente";
    private string mensaje = "";
    private string tipoMensaje = "success";

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        try
        {
            cargando = true;

            clientes = await Http.GetFromJsonAsync<List<Cliente>>(
                "api/Clientes"
            ) ?? new List<Cliente>();
        }
        catch
        {
            clientes = new List<Cliente>();

            MostrarMensaje(
                "No se pudo obtener el listado de clientes.",
                "danger"
            );
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoCliente()
    {
        clienteFormulario = new Cliente
        {
            fecha_nacimiento = DateTime.Today
        };

        editando = false;
        tituloModal = "Nuevo Cliente";

        PrepararFormulario();

        mostrarModal = true;
    }

    private void EditarCliente(Cliente cliente)
    {
        clienteFormulario = new Cliente
        {
            id_cliente = cliente.id_cliente,
            cui = cliente.cui,
            nit = cliente.nit,
            nombres = cliente.nombres,
            apellidos = cliente.apellidos,
            direccion = cliente.direccion,
            telefono = cliente.telefono,
            fecha_nacimiento = cliente.fecha_nacimiento
        };

        editando = true;
        tituloModal = "Editar Cliente";

        PrepararFormulario();

        mostrarModal = true;
    }

    private void PrepararFormulario()
    {
        editContext = new EditContext(clienteFormulario);

        editContext.SetFieldCssClassProvider(
            new BootstrapFieldClassProvider()
        );
    }

    private async Task GuardarCliente()
    {
        try
        {
            if (editando)
            {
                var respuesta = await Http.PutAsJsonAsync(
                    $"api/Clientes/{clienteFormulario.id_cliente}",
                    clienteFormulario
                );

                if (!respuesta.IsSuccessStatusCode)
                {
                    MostrarMensaje(
                        "No se pudo actualizar el cliente.",
                        "danger"
                    );

                    return;
                }

                MostrarMensaje(
                    "Cliente actualizado correctamente.",
                    "success"
                );
            }
            else
            {
                var respuesta = await Http.PostAsJsonAsync(
                    "api/Clientes",
                    clienteFormulario
                );

                if (!respuesta.IsSuccessStatusCode)
                {
                    MostrarMensaje(
                        "No se pudo registrar el cliente.",
                        "danger"
                    );

                    return;
                }

                MostrarMensaje(
                    "Cliente registrado correctamente.",
                    "success"
                );
            }

            mostrarModal = false;

            await CargarClientes();
        }
        catch
        {
            MostrarMensaje(
                "Ocurrió un error al guardar el cliente.",
                "danger"
            );
        }
    }

    private void ConfirmarEliminar(Cliente cliente)
    {
        clienteEliminar = cliente;
        mostrarEliminar = true;
    }

    private async Task EliminarCliente()
    {
        if (clienteEliminar is null)
        {
            return;
        }

        try
        {
            var respuesta = await Http.DeleteAsync(
                $"api/Clientes/{clienteEliminar.id_cliente}"
            );

            if (!respuesta.IsSuccessStatusCode)
            {
                MostrarMensaje(
                    "No se pudo eliminar el cliente.",
                    "danger"
                );

                return;
            }

            MostrarMensaje(
                "Cliente eliminado correctamente.",
                "success"
            );

            mostrarEliminar = false;
            clienteEliminar = null;

            await CargarClientes();
        }
        catch
        {
            MostrarMensaje(
                "Ocurrió un error al eliminar el cliente.",
                "danger"
            );
        }
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private void CerrarEliminar()
    {
        mostrarEliminar = false;
        clienteEliminar = null;
    }

    private void MostrarMensaje(string texto, string tipo)
    {
        mensaje = texto;
        tipoMensaje = tipo;
    }

    private void CerrarMensaje()
    {
        mensaje = "";
    }

    private sealed class BootstrapFieldClassProvider : FieldCssClassProvider
    {
        public override string GetFieldCssClass(
            EditContext editContext,
            in FieldIdentifier fieldIdentifier)
        {
            var tieneErrores =
                editContext.GetValidationMessages(fieldIdentifier).Any();

            if (tieneErrores)
            {
                return "is-invalid";
            }

            if (editContext.IsModified(fieldIdentifier))
            {
                return "is-valid";
            }

            return "";
        }
    }
}